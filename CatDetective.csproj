<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Disable implicit usings so every file's dependencies are explicit -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CatDetective</AssemblyName>
    <RootNamespace>CatDetective</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The web host project (CatDetectiveWeb) lives inside this folder and
         glob-includes THIS project's sources; keep its own out of the desktop build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CatDetectiveWeb\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    KNI NOTE
    =========
    This project targets MonoGame.Framework.DesktopGL for local development.
    For the final WASM / Web build (as described in the GDD), swap this package
    reference for the appropriate KNI platform package, e.g.:
        nkast.Kni.Platform.Browser.Blazor
    The entire game-logic codebase stays identical — only this reference changes.
  -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>

  <!-- Content.Web.mgcb is the KNI/BlazorGL variant (built by CatDetectiveWeb);
       MonoGame's MGCB globs every .mgcb inside its CollectContentReferences
       target and can't parse the Brotli option, so it must be dropped from the
       collected items between collection and the mgcb run. -->
  <Target Name="ExcludeWebContentReference"
          AfterTargets="CollectContentReferences"
          BeforeTargets="PrepareContentBuilder">
    <ItemGroup>
      <ContentReference Remove="Content\Content.Web.mgcb" />
      <ContentReference Remove="Content/Content.Web.mgcb" />
    </ItemGroup>
  </Target>

  <!--
    The Tiled map is read at runtime with System.Text.Json, NOT through the
    content pipeline, so we copy it to the output directory directly.
  -->
  <ItemGroup>
    <Content Include="Content\scenes_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Content\Levels\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
